[Desktop Entry]
Name=Bluetooth
Comment=Manage Bluetooth devices
Type=Application
Exec=wmde-applet-bluetooth
Terminal=false
Categories=WMDE;
Keywords=WMDE;Applet;Bluetooth;
Icon=fun.wmde.AppletBluetooth-symbolic
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-CosmicShrinkable=true
X-CosmicHoverPopup=Auto
X-OverflowPriority=10
