[Desktop Entry]
Name=Network
Comment=Manage network connections
Type=Application
Exec=wmde-applet-network
Terminal=false
Categories=WMDE;
Keywords=WMDE;Applet;Network;
Icon=fun.wmde.AppletNetwork-symbolic
