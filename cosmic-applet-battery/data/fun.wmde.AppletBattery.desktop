[Desktop Entry]
Name=Power & Battery
Comment=Power modes and power saving options
Type=Application
Exec=wmde-applet-battery
Terminal=false
Categories=WMDE;
Keywords=WMDE;Applet;Power;Battery;
Icon=fun.wmde.AppletBattery-symbolic
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-CosmicShrinkable=true
X-CosmicHoverPopup=Start
X-OverflowPriority=10
