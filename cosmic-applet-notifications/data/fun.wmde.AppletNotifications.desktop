[Desktop Entry]
Name=Notifications Center
Comment=Manage notifications and Do Not Disturb
Type=Application
Exec=wmde-applet-notifications
Terminal=false
Categories=WMDE;
Keywords=WMDE;Applet;Notification;
Icon=fun.wmde.AppletNotifications-symbolic
NoDisplay=true
X-CosmicApplet=true
X-CosmicShrinkable=true
X-NotificationsApplet=true
X-CosmicHoverPopup=Auto
X-OverflowPriority=10
