// WMDE applet settings schema. See .doc/settings/08-applet-schemas.md.
//
// This applet stores nothing of its own: it is a panel view onto settings that already
// have a page. The schema exists so that the applet is not a dead end.
(
    schema: 1,
    config: (id: "fun.wmde.AppletTiling", version: 1),
    groups: [
        (
            title: { "": "Settings", "uk": "Налаштування" },
            rows: [
                Note(text: { "": "Tiling behaviour, gaps and the active window hint.", "uk": "Мозаїчне впорядкування, проміжки та підсвітка активного вікна." }),
                Link(page: "window-management", label: { "": "Window management", "uk": "Керування вікнами" }),
            ],
        ),
    ],
)
