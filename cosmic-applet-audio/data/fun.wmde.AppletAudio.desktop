[Desktop Entry]
Name=Sound
Comment=Audio device selection, volume control, and MPRIS media controls
Type=Application
Exec=wmde-applet-audio
Terminal=false
Categories=WMDE;
Keywords=WMDE;Applet;Sound;Audio;MPRIS;
Icon=fun.wmde.AppletAudio-symbolic
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-CosmicShrinkable=true
X-CosmicHoverPopup=End
X-OverflowPriority=10
